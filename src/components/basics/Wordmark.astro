---
/* The mark: a threshold. An opening you pass through, with the base left
 * deliberately open — you are meant to walk through it, not admire it.
 * Colour comes entirely from currentColor and one semantic token. */
export interface Props {
  size?: number;
  showText?: boolean;
  href?: string;
}
const { size = 30, showText = true, href = '/' } = Astro.props;
---

<a class="wm" href={href} aria-label="Threshold, home">
  <svg
    class="wm-mark"
    width={size}
    height={size}
    viewBox="0 0 32 32"
    fill="none"
    aria-hidden="true"
    focusable="false"
  >
    <path
      d="M9 26V15a7 7 0 0 1 14 0v11"
      stroke="currentColor"
      stroke-width="2.4"
      stroke-linecap="round"
    />
    <circle cx="16" cy="15.5" r="2.4" class="wm-dot" />
  </svg>
  {showText && <span class="wm-text">Threshold</span>}
</a>

<style>
  .wm {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--color-text);
    text-decoration: none;
  }
  .wm:hover { color: var(--color-primary); }
  .wm-mark { flex: 0 0 auto; }
  .wm-dot { fill: var(--color-primary); }
  .wm-text {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    letter-spacing: 0.01em;
  }
</style>
