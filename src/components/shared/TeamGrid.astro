---
/* ============================================================================
 * TeamGrid — one group of people from her About page (founders, oral health
 * experts, or health coaches).
 *
 * Founders render as long-form entries with their full bios; everyone else
 * renders as a compact card (photo, name, post-nominals, role, focus). The
 * photos are hers, copied locally. Name and credentials are real text, never
 * baked into an image, so they survive any mode and any screen reader.
 * ========================================================================== */
import type { Person } from '../../lib/site';

interface Props {
  people: readonly Person[];
  layout?: 'feature' | 'grid';
  variant?: 'journal' | 'atlas' | 'practice';
}
const { people, layout = 'grid', variant = 'journal' } = Astro.props;
---

<ol class={`team team--${layout} team--${variant}`}>
  {people.map((p, i) => (
    <li class="person">
      {p.photo && (
        <div class="frame">
          <img src={p.photo} alt={`Portrait of ${p.name}`} loading="lazy" decoding="async" />
        </div>
      )}
      <div class="copy">
        <p class="idx tabular" aria-hidden="true">{String(i + 1).padStart(2, '0')}</p>
        <h3 class="name">{p.name}</h3>
        <p class="cred">{p.credential}</p>
        <p class="role">{p.role}</p>
        {layout === 'feature' && p.bio ? <p class="bio">{p.bio}</p> : <p class="focus">{p.focus}</p>}
      </div>
    </li>
  ))}
</ol>

<style>
  .team {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.5rem 1.25rem;
    container-type: inline-size;
  }
  .team--grid { grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr)); }
  .team--feature { grid-template-columns: 1fr; gap: 2.5rem; }

  .person { min-width: 0; display: flex; flex-direction: column; gap: 0.85rem; }
  .team--feature .person { display: grid; gap: 1.25rem 2rem; }
  @media (min-width: 44rem) {
    .team--feature .person { grid-template-columns: 13rem minmax(0, 1fr); align-items: start; }
  }

  .frame {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-control, 0.5rem);
  }
  .frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    display: block;
  }

  .copy { min-width: 0; }
  .idx {
    margin: 0 0 0.35rem;
    font-family: var(--font-data);
    font-size: 0.6875rem;
    color: var(--color-text-faint);
  }
  .name {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.1875rem;
    line-height: 1.2;
    color: var(--color-text);
  }
  .team--feature .name { font-size: clamp(1.4rem, 3vw, 1.85rem); }
  .cred {
    margin: 0.25rem 0 0;
    font-family: var(--font-data);
    font-size: 0.75rem;
    letter-spacing: 0.03em;
    color: var(--color-primary);
  }
  .role {
    margin: 0.35rem 0 0;
    font-family: var(--font-eyebrow, var(--font-data));
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }
  .focus, .bio {
    margin: 0.6rem 0 0;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }
  .bio { font-size: 1rem; line-height: 1.7; max-width: 62ch; }

  /* Variant composition only. */
  .team--journal .frame { border-radius: 0; filter: grayscale(0.35); }
  .team--atlas .frame { border-radius: 0; }
  .team--practice .frame { border-radius: 1.25rem; }
</style>
