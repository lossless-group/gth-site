---
/* ============================================================================
 * TheTerm — the bridge from the symptom to the vocabulary.
 *
 * This component exists so that no term of art on this page arrives before the
 * everyday thing it names. SymptomEntry has already said "your mouth is full
 * of bacteria, some protect you and some make you ill" in words a stranger
 * already owns. Only now does the page hand over the labels — and it hands
 * them over as a courtesy ("you are about to meet these on a lab form"),
 * not as a credential.
 *
 * The little glossary is the same contract at word scale: plain meaning on the
 * left of the colon in the reader's head, term on the left of the card only
 * because that is what they will be searching for later.
 * ========================================================================== */
import { ORIENTATION } from '../../lib/site';

const GLOSSARY = [
  {
    term: 'Oral microbiome',
    plain: 'The community of bacteria living in your mouth, and how they are balanced against each other.',
  },
  {
    term: 'Orobiome panel',
    plain: 'Our name for the saliva test that reads that community and tells you which strains you actually have.',
  },
  {
    term: 'Dysbiosis',
    plain: 'The wrong bacteria outnumbering the right ones. It is the situation, not a disease you catch.',
  },
];
---

<section class="term" aria-labelledby="term-title">
  <div class="wrap">
    <div class="say">
      <h2 id="term-title">Now the words, since you will meet them anyway.</h2>
      <p class="lead">{ORIENTATION.then_the_term}</p>
      <p class="body">
        You do not need either of those words to use the test. I am giving them
        to you here because they are about to turn up on lab paperwork, in the
        articles further down this page, and in your dentist's mouth — and I
        would rather you met them from me than from a form.
      </p>
    </div>

    <dl class="glossary">
      {
        GLOSSARY.map((g) => (
          <div class="entry">
            <dt>{g.term}</dt>
            <dd>{g.plain}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .term {
    padding-block: clamp(2.5rem, 6vw, 4rem);
    background: var(--color-surface);
    border-block: 1px solid var(--color-grid);
  }

  .wrap {
    max-width: var(--page-measure);
    margin-inline: auto;
    padding-inline: var(--page-gutter);
    display: grid;
    gap: clamp(1.75rem, 4vw, 3rem);
    align-items: start;
  }
  @media (min-width: 56rem) {
    .wrap { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
  }

  h2 {
    margin: 0;
    max-width: 22ch;
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 144;
    font-weight: 390;
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    line-height: 1.14;
    letter-spacing: -0.015em;
    color: var(--color-text);
    text-wrap: balance;
  }

  .lead {
    margin: 1.1rem 0 0;
    max-width: 44ch;
    font-size: clamp(1.0625rem, 1.9vw, 1.1875rem);
    line-height: 1.6;
    color: var(--color-text);
    border-left: 2px solid var(--color-primary);
    padding-left: 1rem;
  }

  .body {
    margin: 1.1rem 0 0;
    max-width: 48ch;
    font-size: 1rem;
    line-height: 1.68;
    color: var(--color-text-muted);
  }

  /* -------------------------------------------------------- glossary -- */
  .glossary {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .entry {
    padding: 1rem 1.15rem;
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-control);
  }

  dt {
    font-family: var(--font-display);
    font-variation-settings: 'opsz' 40;
    font-weight: 560;
    font-size: 1rem;
    line-height: 1.3;
    color: var(--color-text);
  }

  dd {
    margin: 0.35rem 0 0;
    font-size: 0.9375rem;
    line-height: 1.58;
    color: var(--color-text-muted);
  }
</style>
