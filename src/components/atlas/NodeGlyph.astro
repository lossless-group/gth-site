---
/* ============================================================================
 * NodeGlyph — the mark that sits on the axis at each stop.
 *
 * Five anatomical marks (mouth, throat, stomach, small intestine, colon) and
 * one instrument mark for the stops that are NOT anatomy — the index plates
 * below the terminus of the tract. The two registers are deliberately
 * different shapes so no reader mistakes "the library" for an organ.
 *
 * Every stroke is `currentColor`. The glyph inherits its colour from the rail,
 * which sets it from a semantic token. There is no fill value in this file.
 * ========================================================================== */

export type NodeName =
  | 'mouth'
  | 'throat'
  | 'stomach'
  | 'small-intestine'
  | 'colon'
  | 'index';

interface Props {
  name: NodeName;
}

const { name } = Astro.props;
---

<svg
  class="glyph"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.4"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'mouth' && (
    <g>
      {/* an open mouth, seen straight on: two lips and a row of teeth */}
      <path d="M2.5 12C6.5 5.5 17.5 5.5 21.5 12C17.5 18.5 6.5 18.5 2.5 12Z" />
      <path d="M7 9.4v1.9M10.3 8.7v2.2M13.7 8.7v2.2M17 9.4v1.9" stroke-width="1.1" />
    </g>
  )}

  {name === 'throat' && (
    <g>
      {/* a tube narrowing as it goes down, with a swallow arrow inside */}
      <path d="M6 3c1 4.2 2.8 5.4 3.3 8.4V21" />
      <path d="M18 3c-1 4.2-2.8 5.4-3.3 8.4V21" />
      <path d="M12 12.5v5.5M10.2 16.3L12 18.2l1.8-1.9" stroke-width="1.1" />
    </g>
  )}

  {name === 'stomach' && (
    <g>
      {/* the J-shaped pouch with its inlet at the top left */}
      <path d="M9 3v3.2" />
      <path d="M9 6.2c-4 1.6-5.2 7-2.6 10.6C8.8 20.2 15 20 16.6 16c1.6-4-.4-7.6-3.4-8.4" />
      <path d="M18.5 9.6c1.2 1.6 1.4 3.6.8 5.2" stroke-width="1.1" />
    </g>
  )}

  {name === 'small-intestine' && (
    <g>
      {/* a serpentine coil — the folded length that does the absorbing */}
      <path d="M5 5h10a3 3 0 0 1 0 6H8a3 3 0 0 0 0 6h11" />
      <path d="M16.4 14.6 19 17l-2.6 2.4" stroke-width="1.1" />
    </g>
  )}

  {name === 'colon' && (
    <g>
      {/* the frame the colon makes around the abdomen */}
      <path d="M5 20V8.4A2.4 2.4 0 0 1 7.4 6h9.2A2.4 2.4 0 0 1 19 8.4V16a2.4 2.4 0 0 1-2.4 2.4H12" />
      <path d="M5 6.2h.1" stroke-width="2.4" />
    </g>
  )}

  {name === 'index' && (
    <g>
      {/* an instrument tick, not an organ: a measured square with a centre */}
      <rect x="5.5" y="5.5" width="13" height="13" rx="0.5" />
      <path d="M12 11.2h.1" stroke-width="2.6" />
    </g>
  )}
</svg>

<style>
  .glyph {
    width: 100%;
    height: 100%;
    display: block;
    color: inherit;
  }
</style>
