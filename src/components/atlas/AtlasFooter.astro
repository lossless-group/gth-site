---
/* ============================================================================
 * AtlasFooter — the terminus of the axis.
 *
 * The rail ends here with an explicit end-mark rather than just stopping, so
 * the page has a bottom edge in the same language as its spine. Carries the
 * DISCLAIMER verbatim (it is the client's regulated wording and is not ours
 * to soften) and the postal address.
 * ========================================================================== */
import { DISCLAIMER } from '../../lib/site';

const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="foot__inner">
    <div class="foot__terminus" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round">
        <path d="M12 1v14" />
        <path d="M6 19h12" />
        <path d="M8 15.5 12 19l4-3.5" />
      </svg>
      <span class="foot__terminus-k">End of the tract</span>
    </div>

    <div class="foot__cols">
      <div class="foot__col">
        <p class="foot__mark">Threshold</p>
        <p class="foot__line">
          A saliva test for the bacteria living in your mouth, read by a
          dentist who explains what to do about it.
        </p>
        <ul class="foot__links">
          <li><a href="/">All three directions</a></li>
          <li><a href="/articles">All articles</a></li>
          <li><a href="#panel">What it costs</a></li>
          <li><a href="#main">Back to the top</a></li>
        </ul>
      </div>

      <div class="foot__col">
        <p class="foot__k">Where we are</p>
        <address class="foot__address">
          Urban Monk Productions, Inc.<br />
          1250 S Capital of Texas Highway<br />
          Building 3, Suite 400 #9039<br />
          Austin, TX 78746
        </address>
      </div>

      <div class="foot__col foot__col--wide">
        <p class="foot__k">Please read this</p>
        <p class="foot__disclaimer">{DISCLAIMER}</p>
      </div>
    </div>

    <p class="foot__rule">
      <span>&copy; {year} Urban Monk Productions, Inc.</span>
      <span class="foot__proto">Design prototype &mdash; direction B, &ldquo;Atlas&rdquo;</span>
    </p>
  </div>
</footer>

<style>
  .foot {
    border-top: 1px solid var(--color-rule);
    background: var(--color-surface);
    margin-top: 2rem;
  }

  .foot__inner {
    max-width: var(--page-measure);
    margin-inline: auto;
    padding: 2.5rem var(--page-gutter) 3rem;
  }

  .foot__terminus {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 2rem;
    color: var(--color-text-faint);
  }
  .foot__terminus svg { width: 1.35rem; height: 1.35rem; flex: 0 0 auto; }
  .foot__terminus-k {
    font-family: var(--font-eyebrow);
    font-size: 0.625rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .foot__cols {
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 52rem) {
    .foot__cols { grid-template-columns: 1.3fr 0.9fr 1.3fr; gap: 2.5rem; }
  }

  .foot__col { min-width: 0; }

  .foot__mark {
    margin: 0 0 0.6rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.125rem;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .foot__line {
    margin: 0 0 1.1rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    max-width: 38ch;
  }

  .foot__k {
    margin: 0 0 0.7rem;
    font-family: var(--font-eyebrow);
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }

  .foot__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .foot__links a {
    font-family: var(--font-data);
    font-size: 0.75rem;
    letter-spacing: 0.03em;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 150ms ease;
  }
  .foot__links a:hover { color: var(--color-primary); }

  .foot__address {
    margin: 0;
    font-family: var(--font-data);
    font-style: normal;
    font-size: 0.8125rem;
    line-height: 1.75;
    color: var(--color-text-muted);
  }

  .foot__disclaimer {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.65;
    color: var(--color-text-muted);
    max-width: 56ch;
    padding-left: 0.9rem;
    border-left: 2px solid var(--color-accent);
  }

  .foot__rule {
    margin: 2.5rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--color-grid);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    font-family: var(--font-data);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    color: var(--color-text-faint);
  }
  .foot__proto { text-transform: uppercase; letter-spacing: 0.14em; }
</style>
