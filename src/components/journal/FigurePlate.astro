---
/* ============================================================================
 * FigurePlate — the one way this direction is allowed to use an image.
 *
 * Journal replaced the hero image with editorial apparatus on purpose, so a
 * photograph or a decorative banner would undo the argument. A numbered plate
 * with a caption in the margin does not: it is what a clinical publication
 * actually does with a figure, and it reinforces the metaphor instead of
 * diluting it.
 *
 * Uses the page's own .jr-section / .jr-sheet / .jr-cols rhythm so the plate
 * lands on the same grid as every other section — body column for the art,
 * margin column for the legend.
 * ========================================================================== */
import Plate from '../basics/Plate.astro';

export interface Props {
  src: string;
  alt: string;
  ratio?: string;
  number: string;
  title: string;
  legend: string;
  tint?: number;
}

const { src, alt, ratio = '16 / 9', number, title, legend, tint = 0.38 } = Astro.props;
---

<section class="jr-section figure" aria-labelledby={`plate-${number}`}>
  <div class="jr-sheet">
    <div class="jr-cols">
      <div class="art">
        <Plate src={src} alt={alt} ratio={ratio} tint={tint} />
      </div>
      <aside class="legend">
        <p class="jr-eyebrow" id={`plate-${number}`}>Plate {number}</p>
        <p class="legend-t">{title}</p>
        <p class="legend-b">{legend}</p>
      </aside>
    </div>
  </div>
</section>

<style>
  /* A plate is printed onto the sheet, so it gets a rule above and below the
     way a figure block does in print — never a border box. */
  .art {
    border-top: 1px solid var(--color-rule);
    border-bottom: 1px solid var(--color-rule);
    padding-block: 1.25rem;
  }
  .legend { padding-top: 1.25rem; }
  .legend-t {
    margin: 0.5rem 0 0;
    font-family: var(--font-display);
    font-size: 1.0625rem;
    line-height: 1.3;
  }
  .legend-b {
    margin: 0.5rem 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }
</style>
