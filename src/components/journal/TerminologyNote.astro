---
/* ============================================================================
 * TerminologyNote — the bridge sentence, given its own rule-bounded band.
 *
 * This is the only place on the page where a coined word is allowed to appear
 * for the first time, and it appears AFTER the reader has been told what the
 * thing is, what they do, and what they get back. Set as a journal's "note on
 * terminology": rules above and below, hanging label, nothing else competing.
 *
 * Accent appearance 2 of 2 — the coined word itself, and nothing else in the
 * band. The oxblood is spent on the single word the reader is being asked to
 * learn, which is the thing that matters most here.
 * ========================================================================== */

export interface Props {
  /** ORIENTATION.then_the_term, verbatim. */
  sentence: string;
  /** The coined word inside it, set in the accent. */
  coined: string;
}

const { sentence, coined } = Astro.props;

/* Split rather than string-replace so the sentence stays the single source of
 * truth in site.ts and the markup stays real elements. If the coined word
 * ever changes and no longer appears, the sentence still renders whole. */
const at = sentence.indexOf(coined);
const before = at >= 0 ? sentence.slice(0, at) : sentence;
const after = at >= 0 ? sentence.slice(at + coined.length) : '';
---

<section class="band" aria-labelledby="term-label">
  <div class="jr-sheet">
    <div class="inner">
      <p class="jr-eyebrow" id="term-label">A note on terminology</p>

      <p class="sentence">
        {before}{at >= 0 && <em class="coined">{coined}</em>}{after}
      </p>

      <p class="gloss jr-note">
        Both words name the thing you have already been told about. Nothing on
        this page requires you to keep either one.
      </p>
    </div>
  </div>
</section>

<style>
  .band {
    border-block: 1px solid var(--color-rule);
    background: var(--color-surface);
    padding-block: clamp(2rem, 5vw, 3.25rem);
  }

  .inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    align-items: start;
  }
  @media (min-width: 56rem) {
    .inner {
      grid-template-columns: 10rem minmax(0, 1fr) minmax(0, 16rem);
      gap: clamp(1.5rem, 4vw, 3rem);
    }
  }

  .inner > .jr-eyebrow {
    padding-top: 0.55rem;
  }

  .sentence {
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 3.2vw, 2rem);
    line-height: 1.28;
    letter-spacing: -0.015em;
    max-width: 30ch;
    color: var(--color-text);
    text-wrap: pretty;
  }

  /* The one coined word on the page, and the only thing in this band wearing
     the accent. */
  .coined {
    font-style: normal;
    color: var(--color-accent);
    white-space: nowrap;
  }

  .gloss {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    padding-top: 0.4rem;
    border-top: 1px solid var(--color-grid);
  }
  @media (min-width: 56rem) {
    .gloss {
      border-top: 0;
      border-left: 1px solid var(--color-grid);
      padding-top: 0.25rem;
      padding-left: 1.25rem;
    }
  }
</style>
